---
import BaseLayout from "./BaseLayout.astro";
import Breadcrumbs from "~/components/Breadcrumbs.astro";

interface Crumb {
  label: string;
  href?: string;
}

interface Props {
  title: string;
  description: string;
  /** Heading shown in the page banner; defaults to `title`. */
  heading?: string;
  eyebrow?: string;
  lead?: string;
  trail?: Crumb[];
  noindex?: boolean;
}

const {
  title,
  description,
  heading,
  eyebrow,
  lead,
  trail = [],
  noindex,
} = Astro.props;
---

<BaseLayout title={title} description={description} noindex={noindex}>
  <div class="page-banner">
    <div class="container">
      <Breadcrumbs trail={trail.length ? trail : [{ label: title }]} inverse />
      {eyebrow && <p class="page-banner__eyebrow">{eyebrow}</p>}
      <h1 class="page-banner__title">{heading ?? title}</h1>
      {lead && <p class="page-banner__lead">{lead}</p>}
    </div>
  </div>

  <slot />
</BaseLayout>

<style>
  .page-banner {
    position: relative;
    padding-block: clamp(2.5rem, 1.5rem + 4vw, 4.5rem);
    background-color: var(--nelac-green-950);
    background-image: radial-gradient(
        120% 130% at 8% -10%,
        rgb(29 122 88 / 0.5),
        transparent 60%
      ),
      radial-gradient(90% 120% at 100% 0%, rgb(193 146 44 / 0.22), transparent 55%);
    color: var(--color-text-inverse);
    overflow: hidden;
  }

  .page-banner__eyebrow {
    margin-block-start: var(--space-5);
    font-size: var(--step--1);
    font-weight: 600;
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--nelac-brass-300);
  }

  .page-banner__title {
    margin-block-start: var(--space-3);
    max-width: 20ch;
    font-size: var(--step-5);
    color: var(--color-text-inverse);
  }

  .page-banner__lead {
    max-width: 58ch;
    margin-block-start: var(--space-4);
    font-size: var(--step-1);
    line-height: 1.6;
    color: var(--color-text-inverse-muted);
  }
</style>
