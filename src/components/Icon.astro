---
/**
 * Inline SVG icon set (24x24, 1.6 stroke). Icons are inlined so the site makes
 * no external requests and there is no icon-font flash.
 */
export type IconName = keyof typeof paths;

const paths = {
  home: '<path d="M3 10.7 12 3.5l9 7.2"/><path d="M5.5 9.6V20a.5.5 0 0 0 .5.5h4V15h4v5.5h4a.5.5 0 0 0 .5-.5V9.6"/>',
  utensils:
