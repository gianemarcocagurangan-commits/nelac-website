---
import { Image } from "astro:assets";
import type { Leader } from "~/content/leadership";

interface Props {
  leader: Leader;
  index?: number;
}

const { leader, index = 0 } = Astro.props;
---

<li class="leader" data-reveal style={`--reveal-delay:${index * 70}ms`}>
  <div class="leader__frame">
    <Image
      src={leader.photo}
      alt={`Portrait of ${leader.name}, ${leader.position} of Northeast Luzon Adventist College`}
      widths={[240, 400, 600]}
      sizes="(min-width: 62rem) 18rem, (min-width: 40rem) 40vw, 80vw"
      loading="lazy"
      class="leader__photo"
    />
  </div>
  <div class="leader__body">
    <h3 class="leader__name">{leader.name}</h3>
    <p class="leader__position">{leader.position}</p>
  </div>
</li>

<style>
  .leader {
    display: flex;
    flex-direction: column;
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition:
      border-color var(--duration) var(--ease-out),
      box-shadow var(--duration) var(--ease-out),
      transform var(--duration) var(--ease-out);
  }

  .leader:hover {
    border-color: var(--nelac-green-200);
    box-shadow: var(--shadow-md);
    transform: translateY(-3px);
  }

  .leader__frame {
    position: relative;
    aspect-ratio: 4 / 5;
    background-color: var(--nelac-green-950);
    overflow: hidden;
  }

  :global(.leader__photo) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    transition: transform var(--duration-slow) var(--ease-out);
  }

  .leader:hover :global(.leader__photo) {
    transform: scale(1.035);
  }

  .leader__body {
    padding: var(--space-4) var(--space-5) var(--space-5);
    border-block-start: 3px solid var(--nelac-brass-500);
  }

  .leader__name {
    font-size: var(--step-1);
    line-height: 1.25;
  }

  .leader__position {
    margin-block-start: var(--space-2);
    font-size: var(--step--1);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  @media (prefers-reduced-motion: reduce) {
    .leader:hover {
      transform: none;
    }
    .leader:hover :global(.leader__photo) {
      transform: none;
    }
  }
</style>
