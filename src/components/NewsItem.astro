---
import { Image } from "astro:assets";
import Icon from "./Icon.astro";
import type { NewsItem } from "~/content/news";

/**
 * Full announcement: the poster the school published, plus its text
 * transcribed so it is readable on a phone, searchable and available to
 * screen readers.
 */
interface Props {
  item: NewsItem;
  index?: number;
}

const { item, index = 0 } = Astro.props;
---

<article
  class="announcement"
  id={item.slug}
  data-reveal
  style={`--reveal-delay:${Math.min(index, 3) * 70}ms`}
>
  <header class="announcement__head">
    <p class="announcement__meta">
      <span class="announcement__category">{item.category}</span>
      {
        item.dateUnstated ? (
          <span class="announcement__date announcement__date--unstated">
            {item.displayDate}
          </span>
        ) : (
          <time class="announcement__date" datetime={item.date}>
            {item.displayDate}
          </time>
        )
      }
    </p>
    <h2 class="announcement__title">{item.title}</h2>
  </header>

  <div class="announcement__grid">
    {
      item.image && (
        <figure class="announcement__figure">
          <Image
            src={item.image}
            alt={item.imageAlt ?? ""}
            widths={[400, 700, 1100]}
            sizes="(min-width: 62rem) 42vw, 92vw"
            loading={index === 0 ? "eager" : "lazy"}
            class="announcement__image"
          />
          <figcaption class="announcement__figcaption">
            The announcement as published by the school.
          </figcaption>
        </figure>
      )
    }

    <div class="announcement__body">
      <div class="prose">
        {item.body.map((paragraph) => <p set:html={paragraph} />)}
      </div>

      {
        item.lists?.map((list) => (
          <div class="announcement__list">
            {list.heading && <h3 class="announcement__list-title">{list.heading}</h3>}
            <ul class="announcement__names">
              {list.names.map((name) => (
                <li>
                  <Icon name="check" size={15} />
                  {name}
                </li>
              ))}
            </ul>
          </div>
        ))
      }

      {
        item.figures && (
          <div class="announcement__figures">
            {item.figures.map((group) => (
              <div class="announcement__figure-group">
                <h3 class="announcement__list-title">{group.label}</h3>
                <dl class="announcement__stats">
                  {group.values.map((value) => (
                    <div>
                      <dt>{value.label}</dt>
                      <dd>{value.value}</dd>
                    </div>
                  ))}
                </dl>
              </div>
            ))}
          </div>
        )
      }

      {
        item.href && (
          <p class="announcement__more">
            <a class="link-arrow" href={item.href}>
              More about this
              <Icon name="arrow-right" size={17} />
            </a>
          </p>
        )
      }
    </div>
  </div>
</article>

<style>
  .announcement {
    padding-block: var(--space-7);
    border-block-start: 1px solid var(--color-border);
    scroll-margin-top: calc(var(--header-height) + 3rem);
  }

  .announcement:first-of-type {
    border-block-start: none;
    padding-block-start: 0;
  }

  .announcement__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    font-size: 0.78rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-text-subtle);
  }

  .announcement__category {
    padding: 0.2rem 0.6rem;
    border-radius: var(--radius-full);
    background-color: var(--nelac-green-50);
    color: var(--color-primary);
    font-weight: 650;
  }

  .announcement__date--unstated {
    font-style: italic;
    text-transform: none;
    letter-spacing: 0;
  }

  .announcement__title {
    max-width: 30ch;
    margin-block-start: var(--space-3);
    font-size: var(--step-3);
  }

  .announcement__grid {
    display: grid;
    gap: var(--space-6);
    margin-block-start: var(--space-5);
    align-items: start;
  }

  @media (min-width: 62rem) {
    .announcement__grid {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1fr);
      gap: var(--space-8);
    }
  }

  .announcement__figure {
    margin: 0;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    background-color: var(--color-surface);
  }

  :global(.announcement__image) {
    width: 100%;
    height: auto;
  }

  .announcement__figcaption {
    padding: var(--space-3) var(--space-4);
    border-block-start: 1px solid var(--color-border);
    font-size: var(--step--1);
    color: var(--color-text-subtle);
  }

  .announcement__list {
    margin-block-start: var(--space-6);
  }

  .announcement__list-title {
    font-family: var(--font-sans);
    font-size: 0.78rem;
    font-weight: 650;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--color-text-subtle);
  }

  .announcement__names {
    display: grid;
    gap: var(--space-2);
    margin: var(--space-3) 0 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 34rem) {
    .announcement__names {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .announcement__names li {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
    font-size: var(--step--1);
    color: var(--color-text-muted);
  }

  .announcement__names :global(svg) {
    flex: none;
    color: var(--color-accent);
    transform: translateY(2px);
  }

  .announcement__figures {
    display: grid;
    gap: var(--space-5);
    margin-block-start: var(--space-6);
  }

  @media (min-width: 34rem) {
    .announcement__figures {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .announcement__stats {
    margin: var(--space-3) 0 0;
    padding: var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background-color: var(--color-surface);
    display: grid;
    gap: var(--space-3);
  }

  .announcement__stats > div {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3);
  }

  .announcement__stats dt {
    font-size: var(--step--1);
    color: var(--color-text-muted);
  }

  .announcement__stats dd {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--step-1);
    font-weight: 600;
    color: var(--color-primary);
  }

  .announcement__more {
    margin-block-start: var(--space-6);
  }
</style>
